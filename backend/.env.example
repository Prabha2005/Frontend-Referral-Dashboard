# backend/.env.example
JWT_SECRET=replace_with_a_generated_secret
DEMO_EMAIL=your_demo_email
DEMO_PASSWORD=your_demo_password

# Deployment / Production Settings:
# Comma-separated list of exact allowed frontend URLs (localhost:3000 is always allowed)
# Example: https://frontend-referral-dashboard.vercel.app,https://your-custom-domain.com
FRONTEND_ORIGINS=https://your-frontend.vercel.app

# Optional custom database path (defaults to backend/referrals.db)
# On Render with persistent disks, you can point this to /var/data/referrals.db
DATABASE_PATH=backend/referrals.db
